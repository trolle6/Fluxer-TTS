# FluxerTools Configuration
# Copy this file to config.env and fill in your values

# Required - Get from https://web.fluxer.app → User Settings → Applications → your bot
FLUXER_TOKEN=your_bot_token_here

# Required - Your Fluxer community (guild) ID
FLUXER_GUILD_ID=

# Required - Main channel ID for bot messages
FLUXER_CHANNEL_ID=

# Optional - TTS channel (when you type here, bot speaks in voice). Defaults to FLUXER_CHANNEL_ID
# TTS_CHANNEL_ID=

# Required - Log channel ID for errors/status
FLUXER_LOG_CHANNEL_ID=

# Required - Moderator role ID for admin commands (Secret Santa, etc.)
FLUXER_MODERATOR_ROLE_ID=

# Required - OpenAI API key (for TTS and DALL-E)
OPENAI_API_KEY=sk-your_openai_key

# Optional - TTS role restriction (only users with this role can use TTS)
# Leave empty for everyone
TTS_ROLE_ID=

# Optional - Owner user ID for owner-only commands
BOT_OWNER_USER_ID=

# Optional - Debug mode (logs every message)
DEBUG_MODE=false
LOG_LEVEL=INFO

# Optional - Pause on exit (Windows, for debugging)
# PAUSE_ON_EXIT=true

# Optional - TTS max chars per message (default 4096 = OpenAI TTS max)
# TTS_MAX_MESSAGE_LENGTH=4096

# Optional - Tuning (defaults in main.py)
MAX_TTS_CACHE=50
MAX_QUEUE_SIZE=50
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW=60
