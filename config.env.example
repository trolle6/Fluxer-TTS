# Docker / TrueNAS environment variables
# Copy to config.env for local docker compose, or set in TrueNAS Custom App → Environment

# ── Required ──────────────────────────────────────────────────────────────────
FLUXER_BOT_TOKEN=your_bot_token_here
OPENAI_API_KEY=sk-your_openai_key

# ── Recommended (channels & roles) ───────────────────────────────────────────
FLUXER_CHANNEL_ID=          # Main channel (also default TTS text channel)
FLUXER_LOG_CHANNEL_ID=      # Bot status / error logs
FLUXER_MODERATOR_ROLE_ID=   # Secret Santa mod commands
TTS_CHANNEL_ID=             # Optional: separate TTS text channel (defaults to FLUXER_CHANNEL_ID)
TTS_ROLE_ID=                # Optional: only users with this role can trigger TTS

# ── Optional API ─────────────────────────────────────────────────────────────
# FLUXER_API_URL=https://api.fluxer.app

# ── TTS tuning (defaults shown — leave blank to keep defaults) ───────────────
# TTS_DEFAULT_VOICE=alloy
# MAX_QUEUE_SIZE=50
# RATE_LIMIT_REQUESTS=15
# RATE_LIMIT_WINDOW=60
# MAX_TTS_CACHE=50
# AUTO_DISCONNECT_TIMEOUT=300
# MAX_IMAGE_CACHE=30

# ── Flags ────────────────────────────────────────────────────────────────────
# DEBUG_MODE=false
# SKIP_API_VALIDATION=false
# SS_DEBUG_START=false
