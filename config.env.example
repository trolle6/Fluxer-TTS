# Docker / compose env file — copy to config.env and fill in values.
# Used by: docker compose --env-file config.env up -d --build

# Required
# FLUXER_BOT_TOKEN or legacy FLUXER_TOKEN
FLUXER_BOT_TOKEN=your_bot_token_here
OPENAI_API_KEY=sk-your_openai_key

# Recommended
FLUXER_LOG_CHANNEL_ID=
FLUXER_MODERATOR_ROLE_ID=
FLUXER_CHANNEL_ID=

# Optional
# TTS_CHANNEL_ID=
# TTS_ROLE_ID=
# FLUXER_API_URL=https://api.fluxer.app
# DEBUG_MODE=false
# SKIP_API_VALIDATION=false
# MAX_QUEUE_SIZE=50
# RATE_LIMIT_REQUESTS=15
# RATE_LIMIT_WINDOW=60
# MAX_TTS_CACHE=50
# AUTO_DISCONNECT_TIMEOUT=300
# MAX_IMAGE_CACHE=30
