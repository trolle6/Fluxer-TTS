#!/bin/bash
# Build and start WaveTech Fluxer Toolbox (C#) in Docker
set -e
cd "$(dirname "$0")"

if [ ! -f config.env ]; then
  echo "Copy config.env.example to config.env and set FLUXER_BOT_TOKEN + OPENAI_API_KEY."
  if [ -f config.env.example ]; then
    cp config.env.example config.env
    echo "Created config.env — edit it, then run ./deploy again."
  fi
  exit 1
fi

mkdir -p data

echo "Building and starting fluxer-bot..."
docker compose --env-file config.env up -d --build

echo ""
echo "Bot is running."
echo "  Logs: docker compose logs -f"
echo "  Stop: docker compose down"
