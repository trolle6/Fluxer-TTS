#!/bin/bash
# Run FluxerTools on NAS / Linux / macOS (Docker)
# 1. Copy this project to your NAS
# 2. Edit config.env with your tokens/IDs
# 3. Run: ./deploy

set -e
cd "$(dirname "$0")"

if [ ! -f config.env ]; then
  echo "Note: no config.env in this directory — set FLUXER_* / OPENAI_* in the environment (TrueNAS UI) or copy config.env.example to config.env"
fi

echo "Building and starting FluxerTools..."
if [ -f config.env ]; then
  docker compose --env-file config.env up -d --build
else
  docker compose up -d --build
fi

echo ""
echo "Bot is running. View logs: docker compose logs -f"
echo "Stop: docker compose down"
