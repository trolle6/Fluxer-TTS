# Copy this file to your TrueNAS host path (same folder as secret_santa data):
#   /mnt/YOURPOOL/apps/fluxer/data/config.env
#
# Inside the container that path is: /app/Data/config.env

# Required
FLUXER_BOT_TOKEN=your_bot_token_here
OPENAI_API_KEY=sk-your_openai_key

# Recommended
FLUXER_CHANNEL_ID=
FLUXER_LOG_CHANNEL_ID=
FLUXER_MODERATOR_ROLE_ID=

# Optional
# TTS_CHANNEL_ID=
# TTS_ROLE_ID=
# FLUXER_API_URL=https://api.fluxer.app
# TTS_DEFAULT_VOICE=alloy
# MAX_QUEUE_SIZE=50
# DEBUG_MODE=false
